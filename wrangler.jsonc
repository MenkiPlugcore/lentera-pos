{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lentera-pos",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "CLOUDINARY_CLOUD_NAME": "dvds41ivm"
  }
}
